# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app
RUN printf '%s' '{"private":true,"type":"module","dependencies":{"react":"^19.0.0","react-dom":"^19.0.0","react-router-dom":"^7.0.0","vite":"^6.0.0"}}' > package.json \
    && npm install --no-audit --no-fund
COPY App.jsx ./App.jsx
RUN printf '%s' '<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>GOQii Tasks</title></head><body><div id="root"></div><script type="module" src="/App.jsx"></script></body></html>' > index.html \
    && npx vite build
FROM nginxinc/nginx-unprivileged:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY <<'EOF' /etc/nginx/conf.d/default.conf
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=ai:10m rate=5r/m;
server {
  listen 8080;
  server_tokens off;
  root /usr/share/nginx/html;
  client_max_body_size 16k;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
  location = /api/login {
    limit_req zone=login burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://api;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
  }
  location = /api/suggest-category {
    limit_req zone=ai burst=2 nodelay;
    limit_req_status 429;
    proxy_pass http://api;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
  }
  location /api/ {
    proxy_pass http://api;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
  }
  location = /phpmyadmin { return 302 /phpmyadmin/; }
  location /phpmyadmin/ {
    client_max_body_size 16m;
    proxy_pass http://phpmyadmin/;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # phpMyAdmin supplies its own CSP; do not inherit the React app's CSP.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
  }
  location / { try_files $uri /index.html; }
}
EOF
